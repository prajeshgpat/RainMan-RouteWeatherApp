# Key used by `npm run build` (the live site). It is a public, HTTP-referrer-restricted browser key.
# TODO(before first deploy): replace the placeholder with the key that is in index.html on main
#   git show origin/main:public/index.html | grep -o 'key=[A-Za-z0-9_-]*'
# The deploy workflows refuse to publish a build that still contains the placeholder.
VITE_GOOGLE_MAPS_KEY=REPLACE_WITH_PUBLIC_REFERRER_RESTRICTED_KEY
